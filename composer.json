{
    "name": "ihsan/umm-alqura-prayer-times",
    "description": "Offline PHP & Laravel library for Islamic prayer (adhan) times using the official Umm al-Qura method, calibrated against the official calendar, with automatic Ramadan Isha and built-in Saudi cities.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "prayer-times",
        "adhan",
        "umm-al-qura",
        "islamic",
        "muslim",
        "salah",
        "hijri",
        "saudi-arabia",
        "offline",
        "laravel"
    ],
    "homepage": "https://github.com/sultan-algarbi/umm-alqura-prayer-times",
    "support": {
        "issues": "https://github.com/sultan-algarbi/umm-alqura-prayer-times/issues",
        "source": "https://github.com/sultan-algarbi/umm-alqura-prayer-times"
    },
    "require": {
        "php": ">=8.1",
        "ext-intl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "suggest": {
        "illuminate/support": "Laravel 12 or 13: auto-discovered service provider and publishable cities config"
    },
    "autoload": {
        "psr-4": {
            "Ihsan\\UmmAlQuraPrayerTimes\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ihsan\\UmmAlQuraPrayerTimes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ihsan\\UmmAlQuraPrayerTimes\\Laravel\\PrayerTimesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
